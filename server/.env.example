# Server Port
PORT=5000

# MongoDB Connection String (Atlas M0 Free Tier or local MongoDB)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/skillverse?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/skillverse

# JWT Secret & Expiry
JWT_SECRET=super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Allowed Frontend Origin(s) for CORS (comma-separated if multiple)
CLIENT_ORIGIN=http://localhost:5173
